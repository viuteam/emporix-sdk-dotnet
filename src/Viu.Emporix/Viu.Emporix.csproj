<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Viu.Emporix</RootNamespace>
    <AssemblyName>Viu.Emporix</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package metadata (ADR-0003: one package, ADR-0006: naming). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Viu.Emporix</PackageId>
    <Authors>viu</Authors>
    <Company>VIU AG</Company>
    <Description>
      Unofficial .NET SDK for the Emporix Commerce Engine, built and maintained by viu.
      Not an official product of Emporix AG. Native AOT compatible, minimal dependencies.
    </Description>
    <PackageTags>emporix;ecommerce;commerce;sdk;storefront;api-client</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/viuteam/emporix-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/viuteam/emporix-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    The configuration binding source generator turns the Bind call in
    AddEmporix(IConfiguration) into generated code at compile time. Without it
    that one call is reflection, and reflection is what ADR-0004 rules out — the
    build would fail on IL2026 and IL3050 rather than quietly shipping a package
    whose AOT promise no longer holds.
  -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!--
    MinVer derives the version from Git tags. Without a tag that yields
    0.0.0-alpha.0.N — correct for a fresh clone, not an error.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Condition="Exists('../../README.md')" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Condition="Exists('../../LICENSE')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Viu.Emporix.Tests" />
  </ItemGroup>

</Project>
