<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Viu.Emporix.MixinSync</RootNamespace>
  </PropertyGroup>

  <!--
    Package metadata, deliberately the same shape as the library's. It shipped
    once with only an id, a description and tags, so nuget.org showed the tool
    with no readme, no licence and no project link. The two lists are kept
    side by side rather than shared: a props layer for two projects would be
    more structure than benefit, and a missing field is visible on the package
    page within minutes of a release.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>emporix-mixins</ToolCommandName>
    <PackageId>Viu.Emporix.MixinSync</PackageId>
    <Authors>viu</Authors>
    <Company>VIU AG</Company>
    <Description>
      Generates typed C# for an Emporix tenant's mixins and detects schema drift.
      Companion tool to the Viu.Emporix SDK. Built and maintained by viu, not an
      official product of Emporix AG.
    </Description>
    <PackageTags>emporix;mixins;json-schema;codegen;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/viuteam/emporix-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/viuteam/emporix-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Its own readme rather than the repository's: that one is SDK documentation,
    and a reader who installs a command-line tool wants the commands.
  -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Condition="Exists('../../LICENSE')" />
  </ItemGroup>

  <!--
    A developer-machine tool, so the trimming and AOT requirements from
    Directory.Build.props do not apply — NJsonSchema cannot satisfy them. Same
    arrangement as tools/Viu.Emporix.SpecSync. Warnings-as-errors stays.
  -->
  <PropertyGroup>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!--
    The same version line as the library, from the same tags. Without this the
    tool packs as 1.0.0 — the SDK default — which is not a version anybody
    tagged, and which nuget.org would then hold forever. It shipped that way
    once: MinVer sat only in the library's project, and nothing said so until
    the release log showed Viu.Emporix.0.3.0 next to MixinSync.1.0.0.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="NJsonSchema.CodeGeneration.CSharp" />
  </ItemGroup>

  <!-- For SchemaService and EmporixClient when pulling from a tenant. -->
  <ItemGroup>
    <ProjectReference Include="../Viu.Emporix/Viu.Emporix.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Viu.Emporix.Tests" />
  </ItemGroup>

</Project>
